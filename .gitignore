# Home Assistant configuration and runtime (development/testing)
config/*
!config/configuration.yaml
!config/demo_scripts.yaml

# Custom components (Marketplace-installed dependencies and dev symlinks)
custom_components/*
!custom_components/chore_calendar/

# Development tool caches and dependency locks
.ruff_cache/
uv.lock

# Virtual environment and shell configuration (when HOME is set to workspace)
.local/
.bashrc
.zshrc

# Card build artifacts and dependencies
card/node_modules/
card/dist/

# Local work documentation
docs/work/

# Python bytecode, test, and coverage artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.venv/
.venv

# VS Code: keep shared project settings only
.vscode/*
!.vscode/settings.default.jsonc
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
